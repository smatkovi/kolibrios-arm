# console.obj's export table (console_coff/console.asm's EXPORTS, version
# 2.9), for tools/mkdll.py; lib_init first, as in KolibriOS's other
# libraries (dll.Load hands it the program's malloc)
lib_init lib_init lib
START con_start
version =0x00020009
con_init con_init_opt
con_write_asciiz
con_write_string
con_printf
con_exit
con_get_flags
con_set_flags
con_kbhit
con_getch
con_getch2
con_gets
con_gets2
con_get_font_height
con_get_cursor_height
con_set_cursor_height
con_cls
con_get_cursor_pos
con_set_cursor_pos
con_set_title
con_get_input
